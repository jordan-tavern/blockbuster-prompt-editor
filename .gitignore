node_modules/
dist/
.DS_Store
# Secrets and local overrides (never commit)
.env
.env.*
!.env.example
.uploads-tmp/
.editor-projects.json
**/.editor-versions/
remotion-jobs/node_modules/
remotion-jobs/out/
# Imported Blockbuster workspaces (large); recreate via Import in the UI
editor-workspaces/*
!editor-workspaces/.gitkeep

# ═══════════════════════════════════════════════════════════════════════════
# Media & large binaries — do not commit (GitHub 100MB hard limit; LFS not used)
# Patterns apply anywhere in the tree unless negated with ! below.
# ═══════════════════════════════════════════════════════════════════════════

# Video
*.mp4
*.mov
*.m4v
*.webm
*.mkv
*.avi
*.mpeg
*.mpg
*.m2ts
*.mts
# (do not use *.ts — would ignore TypeScript; use *.m2ts / .mts for transport streams)
*.flv
*.wmv
*.3gp

# Audio
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.wma
*.aiff
*.aif

# Raster / stills (b-roll, exports, screenshots — add locally; keep .gitkeep in empty dirs)
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.bmp
*.tiff
*.tif
*.heic
*.exr
*.psd

# Archives / disk images often used for media bundles
*.zip
*.7z
*.rar
*.tar
*.gz
*.dmg
*.iso

# Common local dump folders (absolute-style paths from repo root)
frames/
rivet_frames/
thumbnails/
whisper_output/

# Sample / upload trees (fonts + small JSON like vo.json stay tracked via negation if needed)
remotion-jobs/public/uploads/

# If you must track a tiny PNG/JPEG inside remotion-jobs/public/, whitelist it explicitly, e.g.:
# !remotion-jobs/public/icons/logo-16.png
